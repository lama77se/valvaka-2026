{
  "name": "valvaka-2026",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "geometry": "node scripts/build-geometry.mjs",
    "bounds": "node scripts/build-district-bounds.mjs",
    "seat-config": "node scripts/build-seat-config.mjs",
    "comparison": "tsx scripts/build-comparison-2022.ts",
    "ingest:reference": "node --env-file=.env.local scripts/ingest-reference.mjs",
    "ingest:district-2022": "node --env-file=.env.local scripts/ingest-district-2022.mjs",
    "verify:mandate": "tsx scripts/verify-mandate.ts",
    "verify:mandate-rf": "tsx scripts/verify-mandate-rf.ts",
    "verify:mandate-kf": "tsx scripts/verify-mandate-kf.ts",
    "verify:aggregate": "tsx scripts/verify-aggregate.ts",
    "simulate:valnatt": "node --env-file=.env.local scripts/simulate-valnatt.mjs",
    "results:reset": "node --env-file=.env.local scripts/reset-results.mjs",
    "verify:realtime": "node --env-file=.env.local scripts/verify-realtime.mjs",
    "replay:2022": "node --env-file=.env.local --import tsx scripts/replay-2022.ts",
    "loadtest:valnatt": "node --env-file=.env.local scripts/loadtest-valnatt.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.109.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "fflate": "^0.8.3",
    "mapshaper": "^0.7.49",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5"
  }
}
