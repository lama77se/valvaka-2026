# Valvaka 2026 — miljövariabler
# Kopiera denna fil till .env.local (gitignore:ad) och fyll i från Supabase-projektet:
#   Supabase Dashboard → Project Settings → API
#
# cp .env.example .env.local

# ── Klient (exponeras i frontend-bundlen — MÅSTE ha VITE_-prefix) ──────────────
# Endast publika värden. RLS i Postgres skyddar datan; anon-nyckeln är säker att
# skicka till webbläsaren.
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Distriktsgeometri (statisk, reprojicerad GeoJSON — Fas 1). Lokalt kan detta
# lämnas tomt: då servas filen från public/ (default '/valdistrikt-2026-wgs84.geojson').
# I produktion (Vercel) MÅSTE den peka på den hostade artefakten i Supabase Storage,
# eftersom public/-filen är gitignore:ad och inte finns i deployen:
#   https://<projekt-ref>.supabase.co/storage/v1/object/public/geometry/valdistrikt-2026-wgs84.geojson
VITE_GEOMETRY_URL=

# ── Server-side ENDAST (aldrig i frontend, aldrig VITE_-prefix) ────────────────
# Service-role-nyckeln kringgår RLS. ALDRIG i Vercels env eller i klientkod.
# Två platser den hör hemma:
#   1. Deployade edge functions: auto-injiceras som SUPABASE_SERVICE_ROLE_KEY av
#      runtime — INGET `supabase secrets set` behövs (CLI:t avvisar SUPABASE_-prefix).
#   2. Lokala server-side-skript (t.ex. scripts/ingest-reference.mjs): läggs i
#      .env.local (gitignore:ad) och läses med `node --env-file=.env.local`.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>  # <-- server/edge only, se ovan
