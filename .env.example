# Valvaka 2026 — miljövariabler
# Kopiera denna fil till .env.local (gitignore:ad) och fyll i från Supabase-projektet:
#   Supabase Dashboard → Project Settings → API
#
# cp .env.example .env.local

# ── Klient (exponeras i frontend-bundlen — MÅSTE ha VITE_-prefix) ──────────────
# Endast publika värden. RLS i Postgres skyddar datan; anon-nyckeln är säker att
# skicka till webbläsaren.
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# ── Server-side ENDAST (aldrig i frontend, aldrig VITE_-prefix) ────────────────
# Service-role-nyckeln kringgår RLS. Den sätts som secret på ingestion-edge-
# funktionen (supabase secrets set ...), ALDRIG i Vercels env eller i klientkod.
# Står här bara som dokumentation — lägg det riktiga värdet i Supabase, inte i .env.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>  # <-- server/edge only
